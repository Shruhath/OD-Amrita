# OD-Amrita api/ environment template. Copy to `.env` (gitignored) and fill in.

# ── Server ──
APP_ENV=development
API_PORT=8443
# Exact comma-separated browser origins allowed to call the API. No wildcard,
# path, query, or credentials mode is accepted.
PORTAL_ALLOWED_ORIGINS=http://localhost:5173

# ── Transport security (NFR15) ──
# The server binds TLS 1.2+ ONLY. Plain HTTP is REJECTED, not redirected: there
# is NO HTTP→HTTPS redirect listener (no :80 listener, no 301). Do not add one.
# TLS termination may be handled by the platform/ingress in production; in that
# case the ingress must also reject (not redirect) plain HTTP.
TLS_ENABLED=true
TLS_MIN_VERSION=1.2
TLS_CERT_FILE=./certs/server.crt
TLS_KEY_FILE=./certs/server.key
HTTP_REDIRECT_LISTENER=false   # MUST stay false — HTTP is rejected, not redirected.
# Set true only when a trusted ingress terminates TLS before this process. It is
# required outside development when TLS_ENABLED=false.
TLS_TERMINATED_BY_TRUSTED_PROXY=false

# ── Database (Postgres) — two DSNs, two roles ──
# od_migrator runs goose (DDL, owns the schema); od_runtime is the app pool
# (DML only, no CREATE/ALTER/DROP — enforced by grants). Roles are bootstrapped
# by db/init/00_roles.sql (docker initdb locally; operator step in prod).
# Use sslmode=require against any non-local Postgres; local docker may disable.
DATABASE_URL_MIGRATOR=postgres://od_migrator:CHANGE_ME@localhost:5432/od_amrita?sslmode=disable
DATABASE_URL_RUNTIME=postgres://od_runtime:CHANGE_ME@localhost:5432/od_amrita?sslmode=disable

# ── Auth (Supabase / Microsoft OIDC) ──
# Supabase brokers Microsoft OAuth and issues the session JWT. The API verifies
# that JWT locally via JWKS, checks issuer/audience, then independently enforces
# the amrita.edu domain family on every protected request.
AUTH_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://YOUR-PROJECT-REF.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_ALLOWED_DOMAIN=amrita.edu
# Comma-separated, lowercased emails provisioned as `admin` on first login
# (Story 1.5b). EMPTY by default → every real login provisions as the
# least-privileged `student`; an admin then elevates teachers/coordinators
# (Epic 2). Whitespace and blank entries are ignored. Do NOT commit a real admin
# email into the repo — set it only in the environment.
# AUTH_BOOTSTRAP_ADMINS=first.admin@amrita.edu,second.admin@amrita.edu
#
# Forced logout / session revocation (Story 1.5c): there are intentionally NO
# Supabase server-side revocation credentials here. Supabase exposes no supported
# API to force-log-out another user's sessions by subject without that user's own
# JWT, so the backend does NOT call Supabase to revoke — it records revocations in
# the local auth_session_revocations deny-list and the auth middleware rejects a
# revoked token on its next request. If a supported target-user revoke API is
# adopted later, add its server-only URL/service-role key here (server-side only —
# NEVER ship a service-role key to mobile/web) and enable the adapter. See
# docs/auth-microsoft-supabase-setup.md.

# ── Card sealing (server-only HMAC keys) ──
# Versioned card-token seal keys. Values are unpadded base64url-encoded random
# bytes; each decoded key must be at least 32 bytes. Do NOT reuse this placeholder
# and never ship these values to web/mobile.
CARD_SEAL_ACTIVE_VERSION=v1
CARD_SEAL_HMAC_KEYS=v1=REPLACE_WITH_BASE64URL_32_BYTE_RANDOM_KEY
