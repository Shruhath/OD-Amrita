# Expo / React Native require a flat (hoisted) node_modules to resolve native
# and Metro deps in a pnpm monorepo. node-linker=hoisted gives an npm-like layout
# at the workspace root while keeping pnpm's workspace + lockfile benefits.
node-linker=hoisted
# Let Expo/RN peer graphs resolve without hard-failing the install.
strict-peer-dependencies=false
