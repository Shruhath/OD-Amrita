# OD-Amrita mobile — public runtime config (Story 1.6).
#
# Copy to `mobile/.env` and fill in real values. The `EXPO_PUBLIC_` prefix makes these
# available in the RN bundle. NONE of these are secrets: the Supabase anon/publishable key
# is not a JWT secret — the @amrita.edu gate is enforced by the Supabase before-user-created
# hook and the Go backend, and every request's JWT is verified server-side. Never commit `.env`.

# Supabase project URL (e.g. https://<project-ref>.supabase.co).
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (public; see note above).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the Go backend the typed API client talks to (e.g. http://localhost:8080).
EXPO_PUBLIC_API_BASE_URL=
